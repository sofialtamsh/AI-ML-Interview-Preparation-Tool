# Copy to backend/.env for local development. Never commit real secrets.
IPP_ENVIRONMENT=development
IPP_DATABASE_URL=postgresql+psycopg://ipp:ipp@localhost:55432/ipp
IPP_FRONTEND_BASE_URL=http://localhost:5173
# Browsers treat http://localhost as secure, but keep this false locally so every browser
# accepts the session cookie over plain HTTP. It MUST be true in production.
IPP_COOKIE_SECURE=false
IPP_LOG_LEVEL=INFO

# AI provider. Paste the OpenRouter key here (never in code or chat), then restart the API.
IPP_OPENROUTER_API_KEY=
# Weekly AI-spend reports start on this date's weekday, in this timezone.
# IPP_USAGE_TRACKING_START=2026-10-27
# IPP_USAGE_TIMEZONE=Asia/Kolkata
